# رابط الموقع الفعلي بعد النشر — يُستخدم في sitemap.xml و robots.txt
# و Open Graph tags و JSON-LD. بدون هذا المتغيّر تُستخدَم قيمة افتراضية
# مؤقتة (isbn-processor.vercel.app) لن تعمل بشكل صحيح لموقعك الحقيقي.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# اختياري — مفتاح Google Books API (المستوى الثالث في سلسلة المصادر
# المتدرجة، lib/cascade.ts). بدونه يعمل التطبيق فعلياً عبر حصة مشتركة
# غير موثَّقة بدقة (أضعف)؛ بمفتاح مجاني عادة (بلا بطاقة ائتمان، تحقق بنفسك
# وقت الإنشاء) تحصل على حصة موثّقة تبلغ 1000 طلب/يوم افتراضياً.
# احصل عليه من: https://console.cloud.google.com → تفعيل "Books API" → Credentials
GOOGLE_BOOKS_API_KEY=
